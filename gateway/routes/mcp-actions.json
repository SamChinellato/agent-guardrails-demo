{
  "id": "mcp-actions",
  "name": "mcp-actions",
  "desc": "Business actions MCP server, through the guard (F3, GW-05)",
  "uri": "/mcp/actions",
  "methods": [
    "POST",
    "GET",
    "DELETE"
  ],
  "plugin_config_id": "pc-mcp",
  "upstream_id": "guard",
  "plugins": {
    "key-auth": {
      "hide_credentials": true
    },
    "consumer-restriction": {
      "type": "consumer_name",
      "whitelist": [
        "executor",
        "probe"
      ],
      "rejected_code": 403,
      "rejected_msg": "consumer not allowed on this route"
    },
    "proxy-rewrite": {
      "headers": {
        "set": {
          "X-Agent-Id": "$consumer_name"
        }
      }
    }
  }
}

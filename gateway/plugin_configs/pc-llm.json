{
  "id": "pc-llm",
  "desc": "Kill-switch hook and telemetry for the LLM route (GW-03)",
  "plugins": {
    "fault-injection": {
      "_meta": {
        "disable": true
      },
      "abort": {
        "http_status": 503,
        "body": "{\"error\":{\"type\":\"kill_switch_engaged\",\"message\":\"AI access suspended by incident response\"}}",
        "headers": {
          "Content-Type": "application/json"
        }
      }
    },
    "opentelemetry": {
      "sampler": {
        "name": "always_on"
      },
      "additional_attributes": [
        "consumer_name",
        "route_id"
      ]
    },
    "prometheus": {
      "prefer_name": true
    },
    "loki-logger": {
      "endpoint_addrs": [
        "${LOKI_URL}"
      ],
      "endpoint_uri": "${LOKI_PUSH_PATH}",
      "headers": "${LOKI_HEADERS}",
      "log_labels": {
        "service_name": "api-gateway",
        "route_id": "$route_id",
        "kubernetes_namespace_name": "${NS_GATEWAY}",
        "k8s_namespace_name": "${NS_GATEWAY}"
      },
      "log_format": {
        "level": "info",
        "trace_id": "$opentelemetry_trace_id",
        "span_id": "$opentelemetry_span_id",
        "consumer": "$consumer_name",
        "route_id": "$route_id",
        "method": "$request_method",
        "uri": "$uri",
        "status": "$status",
        "latency_s": "$request_time",
        "upstream": "$upstream_addr",
        "upstream_status": "$upstream_status",
        "upstream_latency_s": "$upstream_response_time"
      },
      "include_req_body": false,
      "include_resp_body": false,
      "inactive_timeout": 2,
      "batch_max_size": 100
    }
  }
}
